# ===========================================
# TELEGRAM FORWARDER BOT - SAFETY EDITION
# ===========================================

# ---- TELETHON (User Session - For Reading Sources) ----
API_ID=YOUR_API_ID_HERE
API_HASH=YOUR_API_HASH_HERE
PHONE_NUMBER=+91XXXXXXXXXX

# ---- TELEGRAM BOT ----
BOT_TOKEN=YOUR_BOT_TOKEN_HERE
ADMIN_ID=YOUR_ADMIN_USER_ID

# ---- DATABASE & SESSION ----
DATABASE_PATH=forwarder_bot.db
SESSION_PATH=session.session
LOG_LEVEL=INFO

# ===========================================
# 🛡️ SAFETY PRESET (Choose ONE)
# ===========================================
# Options: conservative | balanced | aggressive

SAFETY_PRESET=balanced

# ===========================================
# ⚙️ SAFETY SETTINGS (Override preset if needed)
# ===========================================

# Message rate limits (per minute/hour/day)
MSGS_PER_MIN_MIN=15        # Min messages per minute
MSGS_PER_MIN_MAX=25        # Max messages per minute  
MSGS_PER_HOUR_LIMIT=800    # Max messages per hour
MSGS_PER_DAY_LIMIT=15000   # Max messages per day (STRICT!)

# Human-like behavior simulation
RANDOM_PAUSE_CHANCE=0.05       # 5% chance of random pause per message
RANDOM_PAUSE_MIN=30            # Random pause: 30 seconds min
RANDOM_PAUSE_MAX=300           # Random pause: 5 minutes max
READ_SIM_MIN=1.0               # "Reading time" simulation: 1 sec min
READ_SIM_MAX=3.0               # "Reading time" simulation: 3 sec max
BREAK_INTERVAL=100             # Take a break every 100 messages
BREAK_DURATION_MIN=60          # Break duration: 1 minute min
BREAK_DURATION_MAX=180         # Break duration: 3 minutes max

# Sleep schedule (avoid suspicious overnight activity)
ENABLE_SLEEP_SCHEDULE=true     # Enable/disable sleep mode
SLEEP_START_HOUR=23            # Stop at 11 PM
SLEEP_END_HOUR=8               # Resume at 8 AM

# Adaptive speed control
SLOWDOWN_FACTOR=2.0            # Multiply delays by this after rate limit
MAX_SLOWDOWN=5.0               # Maximum slowdown multiplier
RECOVERY_COUNT=50              # Messages before recovering speed

# Batch processing
BATCH_SIZE=25                  # Messages per batch commit
BATCH_DELAY=3.0                # Seconds between batches

# Retry logic
MAX_RETRIES=3                  # Max retries per failed message
RETRY_DELAY_BASE=10.0          # Base delay for retries (seconds)
RETRY_BACKOFF=2.0              # Multiply delay by this each retry

# Auto-pause triggers
ERROR_THRESHOLD=3              # Pause after N consecutive errors
AUTO_PAUSE_DURATION=120        # Auto-pause duration (seconds)

# Warning thresholds (% of limit to trigger warning)
HOURLY_WARNING=80              # Warn at 80% of hourly limit
DAILY_WARNING=80               # Warn at 80% of daily limit

# Forwarding method
FORWARD_VIA_BOT=true           # Forward via bot API (recommended)
SKIP_EXISTING=true             # Skip already-forwarded messages
