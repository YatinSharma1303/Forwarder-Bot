{
  "$schema": "https://railway.app/railway.schema.json",
  "railwayConfigVersion": 2,
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfig": {
      "providers": {
        "python": {
          "packageManager": "pip"
        }
      },
      "variables": {
        "PYTHON_VERSION": "3.11"
      }
    }
  },
  "deploy": {
    "startCommand": "python bot.py",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
